# Copy to .env for `vercel dev`; on Vercel set these in Project Settings → Environment Variables.

# Renflair SMS API key (renflair.in/sms.php → API Key → Show)
RENFLAIR_API_KEY=

# Firebase service account JSON on one line
# (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT=

# Any long random string; used to hash OTPs before they are stored
OTP_SECRET=

# Optional: test numbers that log in with a fixed code and never send an SMS
# (for App Store / Play Store review). Format: 9000000000:1234,9000000001:4321
OTP_TEST_NUMBERS=
