rules_version = '2';

// MagicMeat security rules.
//
// Collections
//   products/{productId}  public read; admins write. Holds the authoritative
//                         price table (prices: { cutKey: unitPrice }) and stock.
//   orders/{orderId}      a customer creates their own orders; every price and
//                         total is checked here against products/*. Customers
//                         read their own orders and may cancel one that is still
//                         "placed". Admins read all and move the status along.
//   users/{uid}           each signed-in user owns their profile.
//   coupons/{CODE}        public read; admins create, edit and delete. An
//                         order's discount is checked here against its coupon.
//   wishlists/{uid}       a customer's saved product ids (own read/write).
//   pushTokens/{uid}      a customer's Expo push token (own write).
//   admins/{uid}          presence marks an admin. Written only with the Admin
//                         SDK (scripts/make-admin.mjs), never from the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isShortString(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    // ---------- products ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- coupons ----------
    function validCoupon(code) {
      let c = request.resource.data;
      return c.keys().hasOnly(['code', 'title', 'description', 'type', 'value', 'minOrder', 'maxDiscount', 'active', 'updatedAt'])
        && c.code == code
        && code.matches('^[A-Z0-9]{3,16}$')
        && c.type in ['flat', 'percent']
        && c.value is int && c.value > 0 && (c.type == 'flat' || c.value <= 90)
        && c.minOrder is int && c.minOrder >= 0
        && c.maxDiscount is int && c.maxDiscount >= 0
        && c.active is bool
        && isShortString(c.title, 1, 60)
        && (!('description' in c) || isShortString(c.description, 0, 200));
    }

    match /coupons/{code} {
      allow read: if true;
      allow create, update: if isAdmin() && validCoupon(code);
      allow delete: if isAdmin();
    }

    // ---------- broadcasts (written only by our server) ----------
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- push tokens ----------
    // The device's Expo push token; read by admins' server code (Admin SDK).
    match /pushTokens/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && isShortString(request.resource.data.token, 10, 200)
        && isShortString(request.resource.data.platform, 1, 20)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- wishlists ----------
    // Each customer's saved product ids, synced across their devices.
    match /wishlists/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- admins ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'updatedAt'])
        && isShortString(request.resource.data.name, 1, 80)
        && isShortString(request.resource.data.phone, 6, 20)
        && (!('email' in request.resource.data) || isShortString(request.resource.data.email, 3, 120))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- orders ----------
    // Rules allow at most 1000 evaluated expressions per request, so these
    // checks are kept lean (scripts/test-rules.ts covers a full 6-line order).
    function validItem(item) {
      // Exactly these 9 keys; values that only feed the display are size-capped
      // by the document limit, the ones that set the price are checked.
      return item.keys().hasOnly(['productId', 'cutId', 'name', 'cutName', 'quantity', 'unitPrice', 'netWeight', 'grossWeight', 'isSkinless'])
        && item.quantity is int
        && item.quantity >= 1 && item.quantity <= 20
        && priceOk(get(/databases/$(database)/documents/products/$(item.productId)).data, item.cutId, item.unitPrice);
    }

    function priceOk(product, cutId, unitPrice) {
      return product.inStock == true && unitPrice is int && product.prices[cutId] == unitPrice;
    }

    // Rules have no loops, so a cart is capped at 6 lines (each up to 20
    // units) and unrolled; 7+ lines would exceed the expression limit.
    function itemOkAt(items, i) {
      return items.size() <= i || validItem(items[i]);
    }

    function lineTotal(items, i) {
      return items.size() > i ? items[i].unitPrice * items[i].quantity : 0;
    }

    function subtotalOf(items) {
      return lineTotal(items, 0) + lineTotal(items, 1) + lineTotal(items, 2)
        + lineTotal(items, 3) + lineTotal(items, 4) + lineTotal(items, 5);
    }

    // Fees and total are checked against o.subtotal, and o.subtotal is
    // checked against the lines exactly once (function arguments are not
    // cached, so re-using a computed subtotal would recompute it).
    function totalsOk(o) {
      return o.subtotal is int
        // Express ('instant') is always 49; Normal is 35 below 499, else free.
        && o.deliveryFee == (o.fulfillment != 'delivery' ? 0
             : (o.deliveryMode == 'instant' ? 49 : (o.subtotal < 499 ? 35 : 0)))
        && o.coldPackagingFee == 0
        && o.discount == discountFor(o)
        && o.total == o.subtotal + o.deliveryFee + o.coldPackagingFee - o.discount
        && o.subtotal == subtotalOf(request.resource.data.items);
    }

    // Coupon discount, the same maths as couponDiscount() in the app:
    // flat ₹value (never above the subtotal) or value% capped at maxDiscount
    // (0 = no cap). Inactive or below minimum order → -1, which never matches.
    function couponDiscount(c, subtotal) {
      return (c.active != true || subtotal < c.minOrder) ? -1
        : c.type == 'flat' ? (c.value < subtotal ? c.value : subtotal)
        : ((c.maxDiscount == 0 || math.floor(subtotal * c.value / 100) < c.maxDiscount)
            ? math.floor(subtotal * c.value / 100) : c.maxDiscount);
    }

    function discountFor(o) {
      return !('couponCode' in o) ? 0
        : couponDiscount(get(/databases/$(database)/documents/coupons/$(o.couponCode)).data, o.subtotal);
    }

    function itemsOk(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 6
        && itemOkAt(items, 0) && itemOkAt(items, 1) && itemOkAt(items, 2)
        && itemOkAt(items, 3) && itemOkAt(items, 4) && itemOkAt(items, 5);
    }

    function validNewOrder(orderId) {
      let o = request.resource.data;
      return o.keys().hasOnly([
          'id', 'customerUid', 'items', 'subtotal', 'deliveryFee', 'coldPackagingFee',
          'discount', 'total', 'status', 'paymentMethod', 'fulfillment', 'deliveryMode',
          'slotLabel', 'eta', 'address', 'deliveryNote', 'customerName', 'customerPhone',
          'lat', 'lng', 'couponCode', 'createdAt', 'updatedAt'])
        && o.id == orderId
        && orderId.matches('^MM-[A-Z0-9]{6,20}$')
        && o.customerUid == request.auth.uid
        && o.status == 'placed'
        && o.paymentMethod == 'Cash on Delivery'
        && o.fulfillment in ['delivery', 'takeaway']
        && o.deliveryMode in ['instant', 'slot']
        && isShortString(o.slotLabel, 1, 80)
        && isShortString(o.eta, 1, 40)
        && isShortString(o.address, 5, 500)
        && (!('deliveryNote' in o) || isShortString(o.deliveryNote, 0, 300))
        && (!('customerName' in o) || isShortString(o.customerName, 0, 80))
        && (!('customerPhone' in o) || isShortString(o.customerPhone, 0, 20))
        // Optional delivery point for rider directions: both or neither.
        && (!('couponCode' in o) || (o.couponCode is string && o.couponCode.matches('^[A-Z0-9]{3,16}$')))
        && (('lat' in o) == ('lng' in o))
        && (!('lat' in o) || (o.lat is number && o.lat >= -90 && o.lat <= 90))
        && (!('lng' in o) || (o.lng is number && o.lng >= -180 && o.lng <= 180))
        && o.createdAt == request.time
        && o.updatedAt == request.time
        && itemsOk(request.resource.data.items)
        && totalsOk(o);
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.customerUid == request.auth.uid || isAdmin());

      allow create: if signedIn() && validNewOrder(orderId);

      // Admin moves an order along and assigns a rider.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'riderName', 'riderPhone', 'currentTempCelsius', 'updatedAt'])
        && request.resource.data.status in
             ['placed', 'butcher_prepping', 'cold_packed', 'rider_assigned', 'out_for_delivery', 'delivered', 'cancelled']
        && request.resource.data.updatedAt == request.time;

      // Customer cancels their own order before the butcher starts.
      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.status == 'placed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
