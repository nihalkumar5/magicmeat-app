# Copy to .env.local. Values come from:
#   firebase apps:sdkconfig WEB --project magicmeat-gmpqj
# This is public client config, not a secret; access is controlled by firestore.rules.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=magicmeat-gmpqj
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=magicmeat-gmpqj.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=magicmeat-gmpqj.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Local development against emulators (npm run emulators). Also set
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-magicmeat so nothing can reach production.
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
